# WindScope UK Environment Configuration Example

# Elexon BMRS API Base URL
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=3

# Default Evaluation Period
EVALUATION_START=2026-01-01
EVALUATION_END=2026-01-31

# Procurement Decision Cutoff Hour (UTC)
# E.g. 9 for 09:00 UTC day-ahead procurement decision
DEFAULT_DECISION_HOUR_UTC=9

# Backend Cache TTL (seconds)
CACHE_TTL_SECONDS=900

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Server Binding
HOST=0.0.0.0
PORT=8000
